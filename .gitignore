# ------------------------------------------------------------
# Internal documentation and Codex scratch files
#
# Do NOT ignore all *.md files. Keep README.md, AGENTS.md,
# architecture docs, API docs, and contributor documentation.
# Use these naming conventions for non-public notes.
# ------------------------------------------------------------
notes/
private/
internal/
scratch/
drafts/
research/
references/private/
codex-scratch/
.codex/
.ai/
.claude/
.cursor/

*.local.md
*.private.md
*.internal.md
*.scratch.md
*_DRAFT.md
*_draft.md
*_NOTES.md
*_notes.md
*_TEMP.md
*_temp.md

# Keep important repository documentation even if a broad rule
# is added later.
!README.md
!AGENTS.md
!CONTRIBUTING.md
!CHANGELOG.md
!SECURITY.md
!CODE_OF_CONDUCT.md
!LICENSE.md
!docs/**/*.md

# ------------------------------------------------------------
# Uploaded proposal/reference assets that should stay local
# Adjust these paths if you intentionally want them in Git.
# ------------------------------------------------------------
references/source-files/
references/raw/
references/ui-samples/
docs/source-files/
docs/raw-assets/
*.local.pdf
*.private.pdf
*.local.docx
*.private.docx

