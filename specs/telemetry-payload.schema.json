{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siagalongsor.local/schemas/telemetry-payload.schema.json",
  "title": "SiagaLongsor Telemetry Payload",
  "description": "Canonical Phase 02 telemetry request body. Device identity is established by the Authorization header, not duplicated in this payload.",
  "type": "object",
  "additionalProperties": false,
  "required": ["messageId", "bootId", "sequence", "timestamp", "firmwareVersion", "readings"],
  "properties": {
    "messageId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64
    },
    "bootId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Changes on every device boot and remains stable for one boot session."
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "description": "Sequence uniqueness is scoped to the authenticated device and bootId."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Device timestamp in ISO 8601 UTC. Runtime rejects timestamps beyond the configurable future-skew limit, default 300 seconds."
    },
    "firmwareVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["WIFI", "CELLULAR", "UNKNOWN"]
        },
        "signalRssi": {
          "type": "number",
          "minimum": -150,
          "maximum": 0,
          "description": "Signal strength in dBm."
        }
      }
    },
    "readings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tiltMagnitudeDeg", "soilMoisturePct", "rainfallMmHour", "batteryVoltage"],
      "properties": {
        "tiltXDeg": {
          "type": ["number", "null"],
          "minimum": -180,
          "maximum": 180
        },
        "tiltYDeg": {
          "type": ["number", "null"],
          "minimum": -180,
          "maximum": 180
        },
        "tiltMagnitudeDeg": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 180
        },
        "soilMoisturePct": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "rainfallMmHour": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Rainfall intensity in millimetres per hour. No static maximum is defined before sensor datasheet review and field calibration."
        },
        "batteryVoltage": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 30
        }
      }
    },
    "deviceAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["riskLevel", "sirenActive"],
      "description": "Optional firmware-reported comparison and audit data. Omission means firmware comparison is unavailable, not that firmware assessed UNKNOWN. An explicit UNKNOWN remains comparison data. This field is not serverRisk and is not a server-authoritative safety decision.",
      "properties": {
        "riskLevel": {
          "type": "string",
          "enum": ["SAFE", "WATCH", "DANGER", "UNKNOWN"]
        },
        "sirenActive": {
          "type": "boolean"
        }
      }
    }
  }
}
