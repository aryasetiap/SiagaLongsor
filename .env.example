# Development infrastructure
POSTGRES_USER=siagalongsor
POSTGRES_PASSWORD=replace-with-local-development-password
POSTGRES_DB=siagalongsor
POSTGRES_PORT=55432
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Active Prisma schema
DATABASE_URL=postgresql://siagalongsor:replace-with-local-development-password@localhost:55432/siagalongsor?schema=public

# API and browser origin
NODE_ENV=development
API_PORT=3001
# Keep 0 locally. Set to the exact trusted reverse-proxy hop count in production.
API_TRUST_PROXY_HOPS=0
WEB_URL=http://localhost:3000

# Authentication
# Generate a unique random value of at least 32 characters. Never reuse this example in production.
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_JWT_ISSUER=siagalongsor-api
AUTH_JWT_AUDIENCE=siagalongsor-web
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_REFRESH_COOKIE_NAME=siagalongsor_refresh
AUTH_LOGIN_RATE_LIMIT_TTL_MS=60000
AUTH_LOGIN_RATE_LIMIT_MAX=5

# Required development seed values
SEED_ORGANIZATION_NAME=SiagaLongsor
SEED_ORGANIZATION_SLUG=siagalongsor
SEED_SITE_NAME=SMAN 17 Bandar Lampung
SEED_SITE_SLUG=sman-17-bandar-lampung
SEED_PROJECT_OWNER_NAME=Project Owner
SEED_PROJECT_OWNER_EMAIL=owner@example.invalid
SEED_PROJECT_OWNER_PASSWORD=replace-with-at-least-12-random-characters
SEED_SCHOOL_ADMIN_NAME=School Admin
SEED_SCHOOL_ADMIN_EMAIL=admin@example.invalid
SEED_SCHOOL_ADMIN_PASSWORD=replace-with-a-different-12-character-password

# Private S3-compatible object storage for SOP documents
# Use a private bucket/container. Values below are placeholders, not production credentials.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=siagalongsor-private
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-local-object-storage-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-local-object-storage-secret-key
OBJECT_STORAGE_FORCE_PATH_STYLE=true
