# Application
NODE_ENV=development
APP_NAME=SiagaLongsor
API_PORT=3001
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
TZ=UTC

# Database
DATABASE_URL=postgresql://siagalongsor:siagalongsor_dev@localhost:5432/siagalongsor?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
AUTH_REFRESH_TOKEN_SECRET=replace-with-a-different-random-secret
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=7d
PASSWORD_PEPPER=replace-with-random-secret

# Device credential hashing/signing
DEVICE_SECRET_PEPPER=replace-with-random-secret
DEVICE_TIMESTAMP_TOLERANCE_SECONDS=900
DEVICE_RATE_LIMIT_PER_MINUTE=120

# Freshness defaults
DEVICE_DELAYED_AFTER_MINUTES=20
DEVICE_OFFLINE_AFTER_MINUTES=35

# Mail development
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=SiagaLongsor <no-reply@localhost>

# Observability
LOG_LEVEL=debug
SENTRY_DSN=

# Optional future MQTT
MQTT_ENABLED=false
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
