# Local-only, synthetic presentation environment. Copy via `corepack pnpm presentation:setup`.
# Do not use physical ESP32 credentials or a production password here.
PRESENTATION_POSTGRES_PASSWORD=replace-with-a-local-postgres-password
PRESENTATION_OWNER_PASSWORD=replace-with-a-local-owner-password-of-at-least-12-characters
PRESENTATION_ADMIN_PASSWORD=replace-with-a-local-admin-password-of-at-least-12-characters
PRESENTATION_AUTH_SECRET=replace-with-a-random-local-secret-of-at-least-32-characters
